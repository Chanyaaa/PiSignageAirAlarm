# Copy to .env and fill in. Never commit .env.
UKRAINEALARM_API_KEY=xxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Region to watch; look up its id in GET https://api.ukrainealarm.com/api/v3/regions
REGION_ID=1293
# Playlist shown during a red alert. If it does not exist in piSignage, the
# groups are left alone.
ALARM_PLAYLIST=ALARM
# Playlist shown during a yellow alert. Optional: if it does not exist in
# piSignage, a yellow alert leaves the normal content on screen.
YELLOW_PLAYLIST=ALARM_YELLOW
# UkraineAlarm rate-limits hard; do not go below 30.
POLL_SECONDS=30
# host.docker.internal is the machine running Docker; piSignage must publish
# port 3000 there. Use the server's LAN address if it runs on another machine.
PISIGNAGE_URL=http://host.docker.internal:3000
PISIGNAGE_USER=pi
PISIGNAGE_PASSWORD=pi
